    smallint actor_id PK,FK
    smallint film_id PK,FK
    timestamp last_update
  }
  film_category {
    smallint film_id PK,FK
    tinyint category_id PK,FK
    timestamp last_update
  }
  film_text {
    smallint film_id PK
    varchar title
    text description
  }
  inventory {
    mediumint inventory_id PK
    smallint film_id FK
    tinyint store_id FK
    timestamp last_update
  }
  language {
    tinyint language_id PK
