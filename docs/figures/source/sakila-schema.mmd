    tinyint category_id PK
    varchar name
    timestamp last_update
  }
  city {
    smallint city_id PK
    varchar city
    smallint country_id FK
    timestamp last_update
  }
  country {
    smallint country_id PK
    varchar country
    timestamp last_update
  }
