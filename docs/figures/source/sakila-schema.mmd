    timestamp last_update
  }
  payment {
    smallint payment_id PK
    smallint customer_id FK
    tinyint staff_id FK
    int rental_id FK
    decimal amount
    datetime payment_date
    timestamp last_update
  }
  rental {
    int rental_id PK
    datetime rental_date
    mediumint inventory_id FK
    smallint customer_id FK
    datetime return_date
    tinyint staff_id FK
    timestamp last_update
  }
  staff {
    tinyint staff_id PK
    varchar first_name
    varchar last_name
    smallint address_id FK
    blob picture
    varchar email
    tinyint store_id FK
