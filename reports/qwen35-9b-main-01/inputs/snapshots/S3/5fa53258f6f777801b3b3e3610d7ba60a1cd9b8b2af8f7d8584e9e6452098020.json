cription":"Waktu pembaruan rekaman.","target":"rental.last_update"},{"description":"Waktu transaksi penyewaan. Memuat tanggal dan waktu awal kejadian penyewaan.","target":"rental.rental_date"},{"description":"ID unik penyewaan.","target":"rental.rental_id"},{"description":"Waktu pengembalian tercatat. Nilai dapat kosong jika waktu pengembalian belum dicatat.","target":"rental.return_date"},{"description":"ID staf pemroses penyewaan.","target":"rental.staff_id"},{"description":"Daftar staf penyewaan. Setiap baris merepresentasikan satu anggota staf.","target":"staff"},{"description":"Penanda staf aktif. Rekaman staf yang meninggalkan pekerjaan dipertahankan dengan status tidak aktif; ini status yang tercatat, bukan rekonstruksi masa lalu.","target":"staff.active"},{"description":"ID alamat terkait.","target":"staff.address_id"},{"description":"Alamat email staf.","target":"staff.email"},{"description":"Nama depan staf.","target":"staff.first_name"},{"description":"Nama belakang staf.","target":"staff.last_name"},{"description":"Waktu pembaruan rekaman.","target":"staff.last_update"},{"description":"Nilai autentikasi akun staf.","target":"staff.password"},{"description":"Data foto staf.","target":"staff.picture"},{"description":"ID unik staf.","target":"staff.staff_id"},{"description":"ID home store staf. Menunjuk home store penugasan staf; staf dapat bekerja di toko lain.","target":"staff.store_id"},{"description":"Nama akun login staf. Digunakan untuk login staf ke sistem penyewaan.","target":"staff.username"},{"description":"Daftar toko penyewaan.","target":"store"},{"description":"ID alamat terkait.","target":"store.address_id"},{"description":"Waktu pembaruan rekaman.","target":"store.last_update"},{"description":"ID staf manajer toko. Staf yang ditetapkan sebagai manajer untuk rekaman toko ini.","target":"store.manager_staff_id"},{"description":"ID unik toko.","target":"store.store_id"}],"technical_schema":{"database":"sakila","tables":[{"columns":[{"name":"acto